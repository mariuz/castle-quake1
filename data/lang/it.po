#: code/gameviewplay.pas
msgid "Commands:"
msgstr "Comandi:"

#: code/gameviewplay.pas
msgid "  map <name>     - Load map (e.g. start, e1m1, lq_e0m1)"
msgstr "  map <name>     - Carica una mappa (es. start, e1m1, lq_e0m1)"

#: code/gameviewplay.pas
msgid "  skill <0..3>   - Skill for the next map"
msgstr "  skill <0..3>   - Difficoltà della prossima mappa"

#: code/gameviewplay.pas
msgid "  record <name>  - Record a demo to <name>.dem, stop ends it"
msgstr "  record <name>  - Registra una demo in <name>.dem, stop la termina"

#: code/gameviewplay.pas
msgid "  save [slot]    - Save the game (F6 = quick)"
msgstr "  save [slot]    - Salva la partita (F6 = rapido)"

#: code/gameviewplay.pas
msgid "  load [slot]    - Load a saved game (F9 = quick)"
msgstr "  load [slot]    - Carica una partita salvata (F9 = rapido)"

#: code/gameviewplay.pas
msgid "  god            - God mode"
msgstr "  god            - Modalità dio"

#: code/gameviewplay.pas
msgid "  give all       - Give all weapons, ammo, keys"
msgstr "  give all       - Dà tutte le armi, munizioni e chiavi"

#: code/gameviewplay.pas
msgid "  shadows <0|1>  - Toggle dynamic shadows"
msgstr "  shadows <0|1>  - Attiva/disattiva le ombre dinamiche"

#: code/gameviewplay.pas
msgid "  wateralpha <0..1> - Opacity of water, slime and lava"
msgstr "  wateralpha <0..1> - Opacità di acqua, melma e lava"

#: code/gameviewplay.pas
msgid "  fog <density> [r g b] - Fog for this level (0 off)"
msgstr "  fog <density> [r g b] - Nebbia per questo livello (0 la toglie)"

#: code/gameviewplay.pas
msgid "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibility"
msgstr "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibilità"

#: code/gameviewplay.pas
msgid "  horde [0|1]    - Waves of monsters on this map; killall - every monster dies"
msgstr "  horde [0|1]    - Ondate di mostri su questa mappa; killall - muoiono tutti i mostri"

#: code/gameviewplay.pas
msgid "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, race the best run, forget it"
msgstr "  speedrun [0|1], ghost [0|1], ghost_reset - Cronometro, sfida la corsa migliore, dimenticala"

#: code/gameviewplay.pas
msgid "  saves          - List the saved games (the Load Game menu)"
msgstr "  saves          - Elenca le partite salvate (il menu Carica partita)"

#: code/gameviewplay.pas
msgid "  photo [0|1] (P) - Photo mode: the game pauses, the camera flies; photo_fov <deg>,"
msgstr "  photo [0|1] (P) - Modalità foto: il gioco si ferma, la camera vola; photo_fov <deg>,"

#: code/gameviewplay.pas
msgid "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"
msgstr "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"

#: code/gameviewplay.pas
msgid "  maps [rating|newest|name|installed] [text] - Quaddicted maps; maps_install <id>,"
msgstr "  maps [rating|newest|name|installed] [text] - Mappe di Quaddicted; maps_install <id>,"

#: code/gameviewplay.pas
msgid "    maps_play <id> [map], maps_remove <id> - download, play and remove one"
msgstr "    maps_play <id> [map], maps_remove <id> - scarica, gioca e rimuove una mappa"

#: code/gameviewplay.pas
msgid "  sky <name> - Skybox gfx/env/<name> for this level (- the scrolling sky)"
msgstr "  sky <name> - Skybox gfx/env/<name> per questo livello (- il cielo scorrevole)"

#: code/gameviewplay.pas
msgid "  fov <degrees>  - Field of view at 4:3 (wider screens see more)"
msgstr "  fov <degrees>  - Campo visivo a 4:3 (gli schermi più larghi vedono di più)"

#: code/gameviewplay.pas
msgid "  gamma <0.4..1.5> - Brightness, lower is brighter"
msgstr "  gamma <0.4..1.5> - Luminosità, più basso è più chiaro"

#: code/gameviewplay.pas
msgid "  cl_bob <0..0.1> - View bob (0 off), r_drawviewmodel <0|1> - the weapon"
msgstr "  cl_bob <0..0.1> - Oscillazione della visuale (0 off), r_drawviewmodel <0|1> - l'arma"

#: code/gameviewplay.pas
msgid "  lightmaps <0|1> - Quake lightmaps or dynamic PBR world lighting"
msgstr "  lightmaps <0|1> - Lightmap di Quake o illuminazione PBR dinamica del mondo"

#: code/gameviewplay.pas
msgid "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"
msgstr "  debug <modes>  - Sovrapposizione: triggers, monsters, movers, leaf, all, off"

#: code/gameviewplay.pas
msgid "  fps            - Show the frame rate in the stats line"
msgstr "  fps            - Mostra i fotogrammi al secondo nella riga delle statistiche"

#: code/gameviewplay.pas
msgid "  novis <0|1>    - 1 draws the whole world, 0 only what the PVS can see"
msgstr "  novis <0|1>    - 1 disegna tutto il mondo, 0 solo ciò che il PVS vede"

#: code/gameviewplay.pas
msgid "  lang <code|auto> - Language of the menu, the HUD and this help"
msgstr "  lang <code|auto> - Lingua del menu, dell'HUD e di questo aiuto"

#: code/gameviewplay.pas
msgid "  quit           - Exit game"
msgstr "  quit           - Esci dal gioco"

#: code/gameviewplay.pas
msgid "Unknown command: "
msgstr "Comando sconosciuto: "

