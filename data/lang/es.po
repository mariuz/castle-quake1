#: code/gameviewplay.pas
msgid "Commands:"
msgstr "Comandos:"

#: code/gameviewplay.pas
msgid "  map <name>     - Load map (e.g. start, e1m1, lq_e0m1)"
msgstr "  map <name>     - Cargar mapa (p. ej. start, e1m1, lq_e0m1)"

#: code/gameviewplay.pas
msgid "  skill <0..3>   - Skill for the next map"
msgstr "  skill <0..3>   - Dificultad del siguiente mapa"

#: code/gameviewplay.pas
msgid "  record <name>  - Record a demo to <name>.dem, stop ends it"
msgstr "  record <name>  - Grabar una demo en <name>.dem, stop la termina"

#: code/gameviewplay.pas
msgid "  save [slot]    - Save the game (F6 = quick)"
msgstr "  save [slot]    - Guardar la partida (F6 = rápido)"

#: code/gameviewplay.pas
msgid "  load [slot]    - Load a saved game (F9 = quick)"
msgstr "  load [slot]    - Cargar una partida guardada (F9 = rápido)"

#: code/gameviewplay.pas
msgid "  god            - God mode"
msgstr "  god            - Modo dios"

#: code/gameviewplay.pas
msgid "  give all       - Give all weapons, ammo, keys"
msgstr "  give all       - Dar todas las armas, munición y llaves"

#: code/gameviewplay.pas
msgid "  shadows <0|1>  - Toggle dynamic shadows"
msgstr "  shadows <0|1>  - Activar o desactivar las sombras dinámicas"

#: code/gameviewplay.pas
msgid "  wateralpha <0..1> - Opacity of water, slime and lava"
msgstr "  wateralpha <0..1> - Opacidad del agua, el limo y la lava"

#: code/gameviewplay.pas
msgid "  fog <density> [r g b] - Fog for this level (0 off)"
msgstr "  fog <density> [r g b] - Niebla de este nivel (0 la quita)"

#: code/gameviewplay.pas
msgid "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibility"
msgstr "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accesibilidad"

#: code/gameviewplay.pas
msgid "  horde [0|1]    - Waves of monsters on this map; killall - every monster dies"
msgstr "  horde [0|1]    - Oleadas de monstruos en este mapa; killall - mueren todos los monstruos"

#: code/gameviewplay.pas
msgid "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, race the best run, forget it"
msgstr "  speedrun [0|1], ghost [0|1], ghost_reset - Cronómetro, competir con la mejor partida, olvidarla"

#: code/gameviewplay.pas
msgid "  saves          - List the saved games (the Load Game menu)"
msgstr "  saves          - Lista las partidas guardadas (el menú Cargar partida)"

#: code/gameviewplay.pas
msgid "  photo [0|1] (P) - Photo mode: the game pauses, the camera flies; photo_fov <deg>,"
msgstr "  photo [0|1] (P) - Modo foto: el juego se pausa, la cámara vuela; photo_fov <deg>,"

#: code/gameviewplay.pas
msgid "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"
msgstr "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"

#: code/gameviewplay.pas
msgid "  maps [rating|newest|name|installed] [text] - Quaddicted maps; maps_install <id>,"
msgstr "  maps [rating|newest|name|installed] [text] - Mapas de Quaddicted; maps_install <id>,"

#: code/gameviewplay.pas
msgid "    maps_play <id> [map], maps_remove <id> - download, play and remove one"
msgstr "    maps_play <id> [map], maps_remove <id> - descargar, jugar y quitar uno"

#: code/gameviewplay.pas
msgid "  sky <name> - Skybox gfx/env/<name> for this level (- the scrolling sky)"
msgstr "  sky <name> - Skybox gfx/env/<name> para este nivel (- el cielo en movimiento)"

#: code/gameviewplay.pas
msgid "  fov <degrees>  - Field of view at 4:3 (wider screens see more)"
msgstr "  fov <degrees>  - Campo de visión en 4:3 (las pantallas más anchas ven más)"

#: code/gameviewplay.pas
msgid "  gamma <0.4..1.5> - Brightness, lower is brighter"
msgstr "  gamma <0.4..1.5> - Brillo, menor es más brillante"

#: code/gameviewplay.pas
msgid "  cl_bob <0..0.1> - View bob (0 off), r_drawviewmodel <0|1> - the weapon"
msgstr "  cl_bob <0..0.1> - Balanceo de la vista (0 sin él), r_drawviewmodel <0|1> - el arma"

#: code/gameviewplay.pas
msgid "  lightmaps <0|1> - Quake lightmaps or dynamic PBR world lighting"
msgstr "  lightmaps <0|1> - Iluminación del mundo con lightmaps de Quake o PBR dinámica"

#: code/gameviewplay.pas
msgid "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"
msgstr "  debug <modes>  - Superposición: triggers, monsters, movers, leaf, all, off"

#: code/gameviewplay.pas
msgid "  fps            - Show the frame rate in the stats line"
msgstr "  fps            - Mostrar los fotogramas por segundo en la línea de estadísticas"

#: code/gameviewplay.pas
msgid "  novis <0|1>    - 1 draws the whole world, 0 only what the PVS can see"
msgstr "  novis <0|1>    - 1 dibuja todo el mundo, 0 solo lo que ve el PVS"

#: code/gameviewplay.pas
msgid "  lang <code|auto> - Language of the menu, the HUD and this help"
msgstr "  lang <code|auto> - Idioma del menú, el HUD y esta ayuda"

#: code/gameviewplay.pas
msgid "  quit           - Exit game"
msgstr "  quit           - Salir del juego"

#: code/gameviewplay.pas
msgid "Unknown command: "
msgstr "Comando desconocido: "

