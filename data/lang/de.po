msgid "Language: %s (%s); lang <code> changes it:%s, auto"
msgstr "Sprache: %s (%s); lang <code> ändert sie:%s, auto"

#: code/gameviewplay.pas
msgid "Commands:"
msgstr "Befehle:"

#: code/gameviewplay.pas
msgid "  map <name>     - Load map (e.g. start, e1m1, lq_e0m1)"
msgstr "  map <name>     - Karte laden (z. B. start, e1m1, lq_e0m1)"

#: code/gameviewplay.pas
msgid "  skill <0..3>   - Skill for the next map"
msgstr "  skill <0..3>   - Schwierigkeitsgrad für die nächste Karte"

#: code/gameviewplay.pas
msgid "  record <name>  - Record a demo to <name>.dem, stop ends it"
msgstr "  record <name>  - Demo in <name>.dem aufnehmen, stop beendet sie"

#: code/gameviewplay.pas
msgid "  save [slot]    - Save the game (F6 = quick)"
msgstr "  save [slot]    - Spiel speichern (F6 = schnell)"

#: code/gameviewplay.pas
msgid "  load [slot]    - Load a saved game (F9 = quick)"
msgstr "  load [slot]    - Gespeichertes Spiel laden (F9 = schnell)"

#: code/gameviewplay.pas
msgid "  god            - God mode"
msgstr "  god            - Gott-Modus"

#: code/gameviewplay.pas
msgid "  give all       - Give all weapons, ammo, keys"
msgstr "  give all       - Alle Waffen, Munition, Schlüssel erhalten"

#: code/gameviewplay.pas
msgid "  shadows <0|1>  - Toggle dynamic shadows"
msgstr "  shadows <0|1>  - Dynamische Schatten ein/aus"

#: code/gameviewplay.pas
msgid "  wateralpha <0..1> - Opacity of water, slime and lava"
msgstr "  wateralpha <0..1> - Deckkraft von Wasser, Schleim und Lava"

#: code/gameviewplay.pas
msgid "  fog <density> [r g b] - Fog for this level (0 off)"
msgstr "  fog <density> [r g b] - Nebel für dieses Level (0 aus)"

#: code/gameviewplay.pas
msgid "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibility"
msgstr "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Barrierefreiheit"

#: code/gameviewplay.pas
msgid "  horde [0|1]    - Waves of monsters on this map; killall - every monster dies"
msgstr "  horde [0|1]    - Monsterwellen auf dieser Karte; killall - alle Monster sterben"

#: code/gameviewplay.pas
msgid "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, race the best run, forget it"
msgstr "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, gegen den besten Lauf antreten, ihn vergessen"

#: code/gameviewplay.pas
msgid "  saves          - List the saved games (the Load Game menu)"
msgstr "  saves          - Gespeicherte Spiele auflisten (das Menü Spiel laden)"

#: code/gameviewplay.pas
msgid "  photo [0|1] (P) - Photo mode: the game pauses, the camera flies; photo_fov <deg>,"
msgstr "  photo [0|1] (P) - Fotomodus: das Spiel pausiert, die Kamera fliegt; photo_fov <deg>,"

#: code/gameviewplay.pas
msgid "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"
msgstr "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"

#: code/gameviewplay.pas
msgid "  maps [rating|newest|name|installed] [text] - Quaddicted maps; maps_install <id>,"
msgstr "  maps [rating|newest|name|installed] [text] - Quaddicted-Karten; maps_install <id>,"

#: code/gameviewplay.pas
msgid "    maps_play <id> [map], maps_remove <id> - download, play and remove one"
msgstr "    maps_play <id> [map], maps_remove <id> - eine herunterladen, spielen und entfernen"

#: code/gameviewplay.pas
msgid "  sky <name> - Skybox gfx/env/<name> for this level (- the scrolling sky)"
msgstr "  sky <name> - Skybox gfx/env/<name> für dieses Level (- der scrollende Himmel)"

#: code/gameviewplay.pas
msgid "  fov <degrees>  - Field of view at 4:3 (wider screens see more)"
msgstr "  fov <degrees>  - Sichtfeld bei 4:3 (breitere Bildschirme sehen mehr)"

#: code/gameviewplay.pas
msgid "  gamma <0.4..1.5> - Brightness, lower is brighter"
msgstr "  gamma <0.4..1.5> - Helligkeit, niedriger ist heller"

#: code/gameviewplay.pas
msgid "  cl_bob <0..0.1> - View bob (0 off), r_drawviewmodel <0|1> - the weapon"
msgstr "  cl_bob <0..0.1> - Kamerawippen (0 aus), r_drawviewmodel <0|1> - die Waffe"

#: code/gameviewplay.pas
msgid "  lightmaps <0|1> - Quake lightmaps or dynamic PBR world lighting"
msgstr "  lightmaps <0|1> - Quake-Lightmaps oder dynamische PBR-Weltbeleuchtung"

#: code/gameviewplay.pas
msgid "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"
msgstr "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"

#: code/gameviewplay.pas
msgid "  fps            - Show the frame rate in the stats line"
msgstr "  fps            - Bildrate in der Statuszeile anzeigen"

#: code/gameviewplay.pas
msgid "  novis <0|1>    - 1 draws the whole world, 0 only what the PVS can see"
msgstr "  novis <0|1>    - 1 zeichnet die ganze Welt, 0 nur, was das PVS sieht"

#: code/gameviewplay.pas
msgid "  lang <code|auto> - Language of the menu, the HUD and this help"
msgstr "  lang <code|auto> - Sprache des Menüs, des HUD und dieser Hilfe"

#: code/gameviewplay.pas
msgid "  quit           - Exit game"
msgstr "  quit           - Spiel beenden"

#: code/gameviewplay.pas
msgid "Unknown command: "
msgstr "Unbekannter Befehl: "

