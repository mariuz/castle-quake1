msgstr "Langue : %s (%s) ; lang <code> la change :%s, auto"

#: code/gameviewplay.pas
msgid "Commands:"
msgstr "Commandes :"

#: code/gameviewplay.pas
msgid "  map <name>     - Load map (e.g. start, e1m1, lq_e0m1)"
msgstr "  map <name>     - Charger une carte (ex. start, e1m1, lq_e0m1)"

#: code/gameviewplay.pas
msgid "  skill <0..3>   - Skill for the next map"
msgstr "  skill <0..3>   - Difficulté de la prochaine carte"

#: code/gameviewplay.pas
msgid "  record <name>  - Record a demo to <name>.dem, stop ends it"
msgstr "  record <name>  - Enregistrer une démo dans <name>.dem, stop l'arrête"

#: code/gameviewplay.pas
msgid "  save [slot]    - Save the game (F6 = quick)"
msgstr "  save [slot]    - Sauvegarder la partie (F6 = rapide)"

#: code/gameviewplay.pas
msgid "  load [slot]    - Load a saved game (F9 = quick)"
msgstr "  load [slot]    - Charger une partie sauvegardée (F9 = rapide)"

#: code/gameviewplay.pas
msgid "  god            - God mode"
msgstr "  god            - Mode invincible"

#: code/gameviewplay.pas
msgid "  give all       - Give all weapons, ammo, keys"
msgstr "  give all       - Donner toutes les armes, munitions et clés"

#: code/gameviewplay.pas
msgid "  shadows <0|1>  - Toggle dynamic shadows"
msgstr "  shadows <0|1>  - Activer/désactiver les ombres dynamiques"

#: code/gameviewplay.pas
msgid "  wateralpha <0..1> - Opacity of water, slime and lava"
msgstr "  wateralpha <0..1> - Opacité de l'eau, du slime et de la lave"

#: code/gameviewplay.pas
msgid "  fog <density> [r g b] - Fog for this level (0 off)"
msgstr "  fog <density> [r g b] - Brouillard de ce niveau (0 aucun)"

#: code/gameviewplay.pas
msgid "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibility"
msgstr "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibilité"

#: code/gameviewplay.pas
msgid "  horde [0|1]    - Waves of monsters on this map; killall - every monster dies"
msgstr "  horde [0|1]    - Vagues de monstres sur cette carte ; killall - tue tous les monstres"

#: code/gameviewplay.pas
msgid "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, race the best run, forget it"
msgstr "  speedrun [0|1], ghost [0|1], ghost_reset - Chrono, course contre le meilleur temps, l'oublier"

#: code/gameviewplay.pas
msgid "  saves          - List the saved games (the Load Game menu)"
msgstr "  saves          - Lister les parties sauvegardées (menu Charger une partie)"

#: code/gameviewplay.pas
msgid "  photo [0|1] (P) - Photo mode: the game pauses, the camera flies; photo_fov <deg>,"
msgstr "  photo [0|1] (P) - Mode photo : le jeu se met en pause, la caméra vole ; photo_fov <deg>,"

#: code/gameviewplay.pas
msgid "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"
msgstr "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"

#: code/gameviewplay.pas
msgid "  maps [rating|newest|name|installed] [text] - Quaddicted maps; maps_install <id>,"
msgstr "  maps [rating|newest|name|installed] [text] - Cartes Quaddicted ; maps_install <id>,"

#: code/gameviewplay.pas
msgid "    maps_play <id> [map], maps_remove <id> - download, play and remove one"
msgstr "    maps_play <id> [map], maps_remove <id> - télécharger, jouer et supprimer une carte"

#: code/gameviewplay.pas
msgid "  sky <name> - Skybox gfx/env/<name> for this level (- the scrolling sky)"
msgstr "  sky <name> - Skybox gfx/env/<name> pour ce niveau (- le ciel défilant)"

#: code/gameviewplay.pas
msgid "  fov <degrees>  - Field of view at 4:3 (wider screens see more)"
msgstr "  fov <degrees>  - Champ de vision en 4:3 (les écrans plus larges voient plus)"

#: code/gameviewplay.pas
msgid "  gamma <0.4..1.5> - Brightness, lower is brighter"
msgstr "  gamma <0.4..1.5> - Luminosité, plus bas est plus clair"

#: code/gameviewplay.pas
msgid "  cl_bob <0..0.1> - View bob (0 off), r_drawviewmodel <0|1> - the weapon"
msgstr "  cl_bob <0..0.1> - Balancement de la vue (0 aucun), r_drawviewmodel <0|1> - l'arme"

#: code/gameviewplay.pas
msgid "  lightmaps <0|1> - Quake lightmaps or dynamic PBR world lighting"
msgstr "  lightmaps <0|1> - Lightmaps de Quake ou éclairage PBR dynamique du monde"

#: code/gameviewplay.pas
msgid "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"
msgstr "  debug <modes>  - Superposition : triggers, monsters, movers, leaf, all, off"

#: code/gameviewplay.pas
msgid "  fps            - Show the frame rate in the stats line"
msgstr "  fps            - Afficher les images par seconde dans la ligne de stats"

#: code/gameviewplay.pas
msgid "  novis <0|1>    - 1 draws the whole world, 0 only what the PVS can see"
msgstr "  novis <0|1>    - 1 dessine tout le monde, 0 seulement ce que le PVS voit"

#: code/gameviewplay.pas
msgid "  lang <code|auto> - Language of the menu, the HUD and this help"
msgstr "  lang <code|auto> - Langue du menu, du HUD et de cette aide"

#: code/gameviewplay.pas
msgid "  quit           - Exit game"
msgstr "  quit           - Quitter le jeu"

#: code/gameviewplay.pas
msgid "Unknown command: "
msgstr "Commande inconnue : "

