#: code/gameviewplay.pas
msgid "Commands:"
msgstr "Comenzi:"

#: code/gameviewplay.pas
msgid "  map <name>     - Load map (e.g. start, e1m1, lq_e0m1)"
msgstr "  map <name>     - Încarcă o hartă (ex. start, e1m1, lq_e0m1)"

#: code/gameviewplay.pas
msgid "  skill <0..3>   - Skill for the next map"
msgstr "  skill <0..3>   - Dificultatea pentru harta următoare"

#: code/gameviewplay.pas
msgid "  record <name>  - Record a demo to <name>.dem, stop ends it"
msgstr "  record <name>  - Înregistrează un demo în <name>.dem, stop îl oprește"

#: code/gameviewplay.pas
msgid "  save [slot]    - Save the game (F6 = quick)"
msgstr "  save [slot]    - Salvează jocul (F6 = rapid)"

#: code/gameviewplay.pas
msgid "  load [slot]    - Load a saved game (F9 = quick)"
msgstr "  load [slot]    - Încarcă un joc salvat (F9 = rapid)"

#: code/gameviewplay.pas
msgid "  god            - God mode"
msgstr "  god            - Mod invincibil"

#: code/gameviewplay.pas
msgid "  give all       - Give all weapons, ammo, keys"
msgstr "  give all       - Toate armele, muniția, cheile"

#: code/gameviewplay.pas
msgid "  shadows <0|1>  - Toggle dynamic shadows"
msgstr "  shadows <0|1>  - Pornește / oprește umbrele dinamice"

#: code/gameviewplay.pas
msgid "  wateralpha <0..1> - Opacity of water, slime and lava"
msgstr "  wateralpha <0..1> - Opacitatea apei, a mâlului și a lavei"

#: code/gameviewplay.pas
msgid "  fog <density> [r g b] - Fog for this level (0 off)"
msgstr "  fog <density> [r g b] - Ceață pentru acest nivel (0 oprită)"

#: code/gameviewplay.pas
msgid "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accessibility"
msgstr "  captions <0|1>, hud_contrast <0|1>, reduced_flashes <0|1> - Accesibilitate"

#: code/gameviewplay.pas
msgid "  horde [0|1]    - Waves of monsters on this map; killall - every monster dies"
msgstr "  horde [0|1]    - Valuri de monștri pe această hartă; killall - toți monștrii mor"

#: code/gameviewplay.pas
msgid "  speedrun [0|1], ghost [0|1], ghost_reset - Timer, race the best run, forget it"
msgstr "  speedrun [0|1], ghost [0|1], ghost_reset - Cronometru, întrecere cu cea mai bună cursă, uitarea ei"

#: code/gameviewplay.pas
msgid "  saves          - List the saved games (the Load Game menu)"
msgstr "  saves          - Lista jocurilor salvate (meniul Încarcă joc)"

#: code/gameviewplay.pas
msgid "  photo [0|1] (P) - Photo mode: the game pauses, the camera flies; photo_fov <deg>,"
msgstr "  photo [0|1] (P) - Mod foto: jocul se oprește, camera zboară; photo_fov <deg>,"

#: code/gameviewplay.pas
msgid "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"
msgstr "    photo_effect <none|dof|gray|sepia|vignette|ao>, photo_scale <1..4>, photo_shot"

#: code/gameviewplay.pas
msgid "  maps [rating|newest|name|installed] [text] - Quaddicted maps; maps_install <id>,"
msgstr "  maps [rating|newest|name|installed] [text] - Hărți Quaddicted; maps_install <id>,"

#: code/gameviewplay.pas
msgid "    maps_play <id> [map], maps_remove <id> - download, play and remove one"
msgstr "    maps_play <id> [map], maps_remove <id> - descarcă, joacă și șterge una"

#: code/gameviewplay.pas
msgid "  sky <name> - Skybox gfx/env/<name> for this level (- the scrolling sky)"
msgstr "  sky <name> - Skybox gfx/env/<name> pentru acest nivel (- cerul în mișcare)"

#: code/gameviewplay.pas
msgid "  fov <degrees>  - Field of view at 4:3 (wider screens see more)"
msgstr "  fov <degrees>  - Câmp vizual la 4:3 (ecranele mai late văd mai mult)"

#: code/gameviewplay.pas
msgid "  gamma <0.4..1.5> - Brightness, lower is brighter"
msgstr "  gamma <0.4..1.5> - Luminozitate, mai mic e mai luminos"

#: code/gameviewplay.pas
msgid "  cl_bob <0..0.1> - View bob (0 off), r_drawviewmodel <0|1> - the weapon"
msgstr "  cl_bob <0..0.1> - Legănarea vederii (0 oprită), r_drawviewmodel <0|1> - arma"

#: code/gameviewplay.pas
msgid "  lightmaps <0|1> - Quake lightmaps or dynamic PBR world lighting"
msgstr "  lightmaps <0|1> - Lightmap-uri Quake sau iluminare PBR dinamică a lumii"

#: code/gameviewplay.pas
msgid "  debug <modes>  - Overlay: triggers, monsters, movers, leaf, all, off"
msgstr "  debug <modes>  - Suprapunere: triggers, monsters, movers, leaf, all, off"

#: code/gameviewplay.pas
msgid "  fps            - Show the frame rate in the stats line"
msgstr "  fps            - Arată numărul de cadre pe secundă în linia de statistici"

#: code/gameviewplay.pas
msgid "  novis <0|1>    - 1 draws the whole world, 0 only what the PVS can see"
msgstr "  novis <0|1>    - 1 desenează toată lumea, 0 doar ce vede PVS"

#: code/gameviewplay.pas
msgid "  lang <code|auto> - Language of the menu, the HUD and this help"
msgstr "  lang <code|auto> - Limba meniului, a HUD-ului și a acestui ajutor"

#: code/gameviewplay.pas
msgid "  quit           - Exit game"
msgstr "  quit           - Ieșire din joc"

#: code/gameviewplay.pas
msgid "Unknown command: "
msgstr "Comandă necunoscută: "

